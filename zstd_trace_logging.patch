diff --git a/lib/common/zstd_trace_log.c b/lib/common/zstd_trace_log.c
new file mode 100644
index 00000000..cf1091e7
--- /dev/null
+++ b/lib/common/zstd_trace_log.c
@@ -0,0 +1,643 @@
